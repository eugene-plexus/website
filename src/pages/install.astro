---
import SiteLayout from '../layouts/SiteLayout.astro';
import Face from '../components/Face.astro';
import Mascot from '../components/Mascot.astro';
import InstallCommand from '../components/InstallCommand.astro';
import release from '../data/alpha-release.json';
const base = `https://eugeneplexus.com/releases/${release.version}`;
const windows = `irm ${base}/install.ps1 | iex`;
const posix = `curl -fsSL ${base}/install.sh | sh`;
const uninstallWindows = `& ([scriptblock]::Create((irm ${base}/install.ps1))) -Uninstall`;
const uninstallPosix = `curl -fsSL ${base}/install.sh | sh -s -- --uninstall`;
const notes = `https://github.com/eugene-plexus/specs/releases/tag/${release.version}`;
const containerGuide = `https://github.com/eugene-plexus/specs/blob/${release.specsCommit}/docs/deployment/container.md`;
const compose = `name: eugene-plexus

services:
  control-plane:
    image: ${release.container}
    hostname: eugene-plexus
    init: true
    restart: unless-stopped
    stop_grace_period: 60s
    ports:
      - "8279:8079" # Browser console
      - "8280:8080" # Application API
      - "8283:8083" # Worker enrollment
    volumes:
      - plexus-data:/data
      - type: bind
        source: ./models
        target: /models
        bind:
          create_host_path: false

volumes:
  plexus-data:
`;
const joinWindows = `& ([scriptblock]::Create((irm ${base}/install.ps1))) -Join 'http://NAS-IP:8283' -Token 'JOIN-TOKEN'`;
const joinLinux = `curl -fsSL ${base}/install.sh | sh -s -- --join 'http://NAS-IP:8283' --token 'JOIN-TOKEN'`;
const askUrl = 'https://github.com/eugene-plexus/specs/issues/new?title=Question%3A%20';
// "Pick your computer": link names stay exactly the section names, and the
// note beside each says who it is for. A script marks the visitor's own
// system; without JavaScript these are plain links to the same sections.
const choices = [
  { id: 'windows', os: 'windows', name: 'Windows', note: 'Most home PCs. One command in PowerShell.' },
  { id: 'linux', os: 'linux', name: 'Linux', note: 'Including WSL on Windows. One command in a terminal.' },
  { id: 'docker', os: 'docker', name: 'Docker / NAS', note: 'A home server, with a separate computer running the models.' },
  { id: 'mac', os: 'mac', name: 'Mac', note: 'Still being tested. Not yet checked on a real Mac.' },
];
---
<SiteLayout title="Install | Eugene Plexus" description={`Install Eugene Plexus ${release.version} on Windows, Linux, or Docker / NAS. Get your first model answering and learn how to update or remove it. The first release.`}>
  <div class="container install-page">
    <div class="install-intro-layout">
      <header class="install-intro">
      <p class="eyebrow">Early testing · {release.version}</p>
      <h1>Get your first model answering.</h1>
      <p data-plain>Pick the computer you will run it on. Installing is one command you paste. Everything after that happens in your web browser.</p>
      <p class="alpha-notice"><strong>This is the first release.</strong> It works, and it is early: expect rough edges. <a href={notes}>Release notes and known limits</a>.</p>
      </header>
      <div class="install-guide"><Mascot pose="guide" size={176} eager /></div>
    </div>
    <nav class="install-nav" aria-label="Installation sections">
      <p class="chooser-label">Pick your computer</p>
      <ul class="chooser" role="list" data-plain>
        {choices.map((choice) => (
          <li class="choice" data-os={choice.os}>
            <a href={`#${choice.id}`}>{choice.name}</a>
            <span class="choice-note">{choice.note}</span>
            <span class="choice-detected" hidden>This device</span>
          </li>
        ))}
      </ul>
      <p class="section-links"><a href="#before">Before you start</a><a href="#first-reply">First reply</a><a href="#update">Update</a><a href="#remove">Remove</a><a href="#help">Get help</a></p>
    </nav>

    <section id="before" aria-labelledby="before-title">
      <h2 id="before-title">Before you start</h2>
      <ul data-plain>
        <li>A 64-bit Windows or Linux computer, with internet access and a web browser.</li>
        <li>16 GB of memory (RAM) and 10 GB of free disk space for a small first model. Bigger models need more.</li>
        <li>A graphics card helps a lot. Without one, models run on the processor, more slowly.</li>
        <li>On Windows, permission to approve an administrator prompt. On Linux, your normal account.</li>
      </ul>
      <p data-plain>You do not need to install Python, Node.js, Git or llama.cpp yourself. Eugene asks before it installs anything else or downloads a model.</p>
      <details>
        <summary>More detail before you install</summary>
        <ul>
          <li>Windows x64 and Linux x64/WSL have been exercised; other hardware has less verification. See the <a href={`https://github.com/eugene-plexus/specs/blob/${release.specsCommit}/docs/support-matrix.md`}>tested configurations</a>.</li>
          <li>Linux needs <code>curl</code> and a systemd user session.</li>
          <li>For Docker / NAS, use an Intel or AMD 64-bit Linux host with Docker Engine and Compose v2, plus a separate Windows or Linux machine to run models. The published container is Linux amd64; ARM NAS hardware is not covered.</li>
          <li>Start with a local model folder. The Windows service runs as the system, so your mapped network drives and saved file-server logins are not inherited. Network storage can be added later under Settings → Model storage on each machine.</li>
          <li>These commands download and run the installer for <strong>{release.version}</strong>. You can <a href={`${base}/install.ps1`}>read the Windows script</a> or <a href={`${base}/install.sh`}>read the Linux/Mac script</a> first. The <a href={notes}>release assets</a> include SHA-256 checksums and the component manifest.</li>
        </ul>
      </details>
    </section>

    <section id="windows" aria-labelledby="windows-title">
      <h2 id="windows-title">1. Install on Windows</h2>
      <p>Open <strong>PowerShell</strong> from the Start menu. Paste this command, press Enter, and approve the administrator prompt when it appears.</p>
      <InstallCommand id="windows-command" command={windows} label="Windows install command" />
      <h3>What you will see</h3>
      <ol class="expect" data-plain>
        <li>Windows asks whether to allow the app to make changes. Choose <strong>Yes</strong>.</li>
        <li>The window may sit quietly for a few minutes while Eugene installs in the background.</li>
        <li>It finishes with a line ending in <code>done.</code> and the path to a log file.</li>
        <li>Open <a href="http://127.0.0.1:8079/">http://127.0.0.1:8079/</a> on this computer. You should see <strong>Choose a passphrase</strong>.</li>
      </ol>
      <p class="expect-help" data-plain><Face size={28} /><span>Nothing opens, or you see a red error? Check <a href="#help">If something goes wrong</a>.</span></p>
      <p>The default install lives in <code>C:\ProgramData\EugenePlexus</code> and runs as a Windows service, so it starts with the computer. If PowerShell was already running as administrator, the last line says <code>Eugene Plexus is running</code> instead.</p>
      <p>If you already have an older per-user installation, the installer will explain the migration before making changes. Read that message and keep your passphrase available; this first-time guide does not automatically migrate an existing setup.</p>
    </section>

    <section id="linux" aria-labelledby="linux-title">
      <h2 id="linux-title">1. Install on Linux</h2>
      <p>Open a terminal as your normal user. Paste this command and press Enter. Do not run it with <code>sudo</code>.</p>
      <InstallCommand id="linux-command" command={posix} label="Linux install command" />
      <h3>What you will see</h3>
      <ol class="expect" data-plain>
        <li>Lines starting with <code>==&gt;</code> scroll past while Eugene installs. This can take a few minutes.</li>
        <li>It finishes with <code>Eugene Plexus is running</code> and an address.</li>
        <li>Open <a href="http://127.0.0.1:8079/">http://127.0.0.1:8079/</a>. You should see <strong>Choose a passphrase</strong>.</li>
      </ol>
      <p class="expect-help" data-plain><Face size={28} /><span>If it prints a different address or a command to start Eugene yourself, follow what it prints.</span></p>
      <p>The installer asks for your password once, through <code>sudo</code>. Eugene installs in <code>/var/lib/eugene-plexus</code> and runs as a system service under its own account, <code>eugene-plexus</code>, so it starts with the computer and programs you run cannot read its keys. It reaches your models folder through your group.</p>
      <p>To install under your own account instead, add <code>-s -- --user</code> after <code>sh</code>: Eugene then lives in <code>~/.local/share/eugene-plexus</code> as a systemd user service that starts when you sign in, or before sign-in if you follow the installer's optional <code>loginctl enable-linger</code> instruction. WSL needs systemd for either; otherwise use the manual command it prints and keep that terminal open.</p>
    </section>

    <section id="docker" aria-labelledby="docker-title">
      <h2 id="docker-title">1. Install with Docker / NAS</h2>
      <p>This runs the console, control root, gateway and model library on your NAS or Linux server. Since alpha.3, the container can also run models itself, on its processor or on a passed-through NVIDIA card, which you turn on. <strong>The container's GPU path has not been checked on physical hardware yet</strong>; the tested way to run models on a GPU is to join a Windows or Linux worker, below.</p>
      <p>Use this example for a <strong>new install</strong>. If Eugene already runs on your NAS, follow <a href="#update">Update</a> and keep its existing storage and ports.</p>

      <h3>Prepare persistent storage</h3>
      <p>Create a project folder on your server. Inside it, create a <code>models</code> folder for your model files and downloads. The container runs as UID/GID <code>10001:10001</code>; give that account read and write access to the models folder through your NAS permissions settings. On an ordinary Linux host, from the new project folder:</p>
      <InstallCommand id="docker-models" command="mkdir models && sudo chown 10001:10001 models" label="Create an empty model folder on Linux" />
      <p>For an existing model collection, change <code>source: ./models</code> below to its absolute host path and grant access to that folder. Keep your existing ownership and sharing setup. The <a href={`${containerGuide}#unraid-from-the-gui`}>Unraid guide</a> covers NAS-specific settings; if using its template, set the image to <code>{release.container}</code> before starting.</p>

      <h3>Save and start the Compose project</h3>
      <p>Save this as <code>compose.yaml</code> in the project folder, or paste it into your NAS's Compose editor with an absolute model-folder path. The <code>plexus-data</code> volume preserves configuration, enrollment, keys and logs; the model folder stays on your host.</p>
      <InstallCommand id="docker-compose" command={compose} label="Docker Compose configuration" preserveLines />
      <p>From that folder, run:</p>
      <InstallCommand id="docker-start" command={'docker compose pull\ndocker compose up -d'} label="Docker startup commands" />
      <p>These ports are reachable on the host's network interfaces. Keep them on a trusted LAN or VPN, and complete first-run setup immediately: the first person to open the console chooses the install's passphrase. No router port forwarding is needed.</p>

      <h3>Open the console and set its address</h3>
      <p>Replace <code>NAS-IP</code> with your server's LAN address. These addresses use the <strong>published host ports</strong> from the example:</p>
      <dl class="docker-addresses">
        <dt>Browser console</dt><dd><code>http://NAS-IP:8279/</code></dd>
        <dt>Application API base URL</dt><dd><code>http://NAS-IP:8280/v1</code></dd>
        <dt>Control root for worker enrollment</dt><dd><code>http://NAS-IP:8283</code></dd>
      </dl>
      <p>Open the console, choose and save your passphrase, and use <code>/models</code> as the model folder inside the container. In <strong>Settings → Access &amp; security</strong>, set the NAS machine's <strong>Advertise address</strong> to <code>http://NAS-IP:8279</code> so other nodes can reach it. If you change the left side of a port mapping, use that new port in the matching address above.</p>

      <h3>Join the computer that will run models</h3>
      <ol>
        <li>In the NAS console, open <strong>Machines → Add a node</strong>. Leave the optional node name blank, set <strong>Control root URL the other machine can reach</strong> to <code>http://NAS-IP:8283</code>, and choose <strong>Mint a join token</strong>.</li>
        <li>Copy the command the page prints for the worker's system and run it there; it installs this release and joins in one step. If you prefer the commands below, replace <code>NAS-IP</code> and <code>JOIN-TOKEN</code> with the address and the token value after <code>-Token</code> or <code>--token</code>. Tokens expire and work once, so mint a new one for each worker.</li>
        <li>If Eugene is already on the worker, from any version or half-finished attempt, the join moves it aside first. Nothing is deleted, and if the join fails the machine is put back as it was, with a message that says why.</li>
      </ol>
      <InstallCommand id="docker-join-windows" command={joinWindows} label="Windows worker join command" />
      <InstallCommand id="docker-join-linux" command={joinLinux} label="Linux worker join command" />
      <p>On Windows, approve the administrator prompt. On Linux, run as your normal user. Check that Machines reports the worker as reachable. The worker must reach the NAS ports above, and the NAS must reach the worker's agent, normally port <code>8079</code>.</p>
      <p>Share the host model folder over SMB or NFS and make it readable on the worker. Under <strong>Settings → Model storage on each machine</strong>, map <code>/models</code> on that worker to its path to the same files. A Windows service needs its own file-server login there too; a mapped desktop drive is not enough.</p>
      <p>In Library, select the worker as the launch target, choose or download a model, and start it there. When it is ready, try Playground using <strong>Through this agent</strong>. For a direct connection or another app, use <code>http://NAS-IP:8280/v1</code> and an application key from <strong>Use it from your apps</strong> on the Home page. The container's internal port <code>8080</code> is not the published API port in this example.</p>
      <p><strong>After a container restart:</strong> sign in to the NAS console to unlock the control root; if your browser is already signed in, sign out and back in. A healthy container can still be locked. See <a href={`${containerGuide}#unattended-unlock`}>unattended unlock</a> for optional startup with a mounted passphrase file.</p>
    </section>

    <section id="mac" aria-labelledby="mac-title">
      <h2 id="mac-title">Mac testing</h2>
      <p>The installer also has a macOS path, but physical Mac verification remains outstanding for this release. If you want to help test it, run the Linux/Mac command in Terminal as your normal user. It installs a launchd agent for your login. MLX and llama.cpp on Metal have run on GitHub's macOS runners, not yet on a physical Mac.</p>
      <InstallCommand id="mac-command" command={posix} label="Mac test install command" />
    </section>

    <section id="first-reply" aria-labelledby="reply-title">
      <h2 id="reply-title">2. Get your first reply</h2>
      <p>For a Windows or Linux standalone install, continue below. For Docker / NAS, finish the worker and model-folder setup in the <a href="#docker">Docker instructions</a> first and launch models on that worker.</p>
      <ol>
        <li><strong>Choose a passphrase.</strong> Save it somewhere you can find again. It protects your install; there is no passphrase recovery.</li>
        <li><strong>Choose where models live.</strong> Accept the proposed folder to start fresh, or choose a folder containing models you already own.</li>
        <li><strong>On the Home page, choose Download and run.</strong> Eugene proposes a model for this machine. Check the download size and approve the engine installation when asked. If a model is already on disk, choose Run.</li>
        <li><strong>Wait for the model to be ready, then send a message.</strong> Downloads and loading appear in Tasks. The first download can be several gigabytes.</li>
      </ol>
      <p>To connect another app, use <strong>Use it from your apps</strong> on the Home page. Make a client key, then copy the address, model name and key into your app. Keep the key private. There are <a href={`https://github.com/eugene-plexus/specs/blob/${release.specsCommit}/docs/application-workflows.md`}>step-by-step recipes for Open WebUI and Claude Code</a>.</p>
      <p>To try your phone, turn on the switch in <strong>Reach it from other devices</strong> on the Home page, and use the address it shows. Keep both devices on a trusted LAN or VPN; <code>127.0.0.1</code> always means the device you are currently using. Finish setup before enabling access from other devices.</p>
    </section>

    <section id="update" aria-labelledby="update-title">
      <h2 id="update-title">Update or repair an install</h2>
      <p><strong>From alpha.4, alpha.5 or alpha.6, update from the console.</strong> <strong>Machines → Versions</strong> (<strong>Nodes → Versions</strong> on alpha.5 and alpha.4) shows what each machine runs and whether a newer version is out, and updates any machine from whichever console you have open. Eugene checks GitHub for a newer version a minute after it starts and every six hours, and installs only when you press Update. <strong>Settings → Updates</strong> turns the check off or changes the channel.</p>
      <p><strong>From alpha.3, run the install command again</strong> on each machine. It stops Eugene, replaces it with {release.version} and starts it again, keeping your passphrase, model files, app keys and joined machines. The service restarts, so let active requests finish first. From then on, update from the console.</p>
      <p><strong>Moving from alpha.2 or earlier is a fresh install.</strong> Alpha.3 changed how the machines in an install prove who they are, and nothing converts the old keys, so the installer recognises an older install and prints the command that removes it. Removing moves it aside rather than deleting it, and no model file is deleted. You then choose a new passphrase, make new app keys, and join your other machines again. The <a href="https://github.com/eugene-plexus/specs/blob/main/docs/releases/v0.1.0-alpha.3.md#moving-from-alpha2">alpha.3 release notes</a> list the steps.</p>
      <p><a href="/recovery">Read the backup and recovery guide before updating.</a> Create and rehearse a checkpoint once your install is set up.</p>
      <p>These versioned commands stay on <strong>{release.version}</strong>; they do not silently follow development changes. Do not run an older installer over a newer installation.</p>
      <details>
        <summary>Already running a NAS or Docker control plane?</summary>
        <p>The matching Linux amd64 image is <code>{release.container}</code>. <strong>From alpha.3 to alpha.6, keep your data folder</strong>: back up first, then change only the image tag in your existing Compose file or NAS container settings, keeping the same project name, hostname, volumes, model-folder mapping and published ports. For Compose, run <code>docker compose pull</code> then <code>docker compose up -d</code> from the existing project folder. Sign in again to unlock the control root after restart. After that, <strong>Machines → Versions</strong> tells the container how to update in its platform's own words.</p>
        <p><strong>If other machines join it, set the container's Advertise address</strong> under <strong>Settings → Access &amp; security</strong> to the address you type in the browser, port included, such as <code>http://NAS-IP:8279</code> with the ports in <a href="#docker">Docker / NAS</a> above. Inside a container the agent cannot see its published address, and without it a worker cannot reach the Library to find your model folders; the Folders page names the machine and says so.</p>
        <p><strong>From alpha.2, start the container with a new, empty data volume</strong>: alpha.3 and later cannot read an alpha.2 control root's data. For a new install, use <a href="#docker">Docker / NAS</a> above.</p>
      </details>
    </section>

    <section id="remove" aria-labelledby="remove-title">
      <h2 id="remove-title">Remove Eugene</h2>
      <p>On Windows, open PowerShell with <strong>Run as administrator</strong> for the default service install, then run:</p>
      <InstallCommand id="windows-remove" command={uninstallWindows} label="Windows removal command" />
      <p>On Linux or Mac, use your normal terminal account:</p>
      <InstallCommand id="posix-remove" command={uninstallPosix} label="Linux and Mac removal command" />
      <p>These commands remove startup registration and the application environment. They leave original model files alone, keep downloaded engines and managed model copies, and move configuration and logs to the backup folder shown in the output. They apply to the default locations above; custom installations need their original prefix.</p>
      <p>For Docker, run <code>docker compose down</code> from the project folder to stop and remove the container while retaining the state volume and model files. Do not add <code>--volumes</code> if you want to keep the install's identity and configuration.</p>
    </section>

    <section id="help" aria-labelledby="help-title">
      <h2 id="help-title" class="with-face"><Face size={44} />If something goes wrong</h2>
      <p>If an update left Eugene unable to start, follow the <a href="/recovery">backup and recovery guide</a>.</p>
      <dl>
        <dt>The first message says the model is still loading</dt>
        <dd>The Home page waits for model readiness before enabling Send. If another client connects while the model is loading, wait for Tasks to show it is ready before sending again. A “still coming up” response does not mean the model has crashed.</dd>
        <dt>The page does not open</dt>
        <dd>Use the address printed by the installer, on the same computer. Read the final error and log location in the terminal. On Linux, check <code>systemctl --user status eugene-plexus-agent</code>; on Windows, look for <code>EugenePlexusAgent</code> in Services.</dd>
        <dt>The model will not start or is too slow</dt>
        <dd>Read the problem shown on the Home page and open Tasks for details. Try a smaller model or a shorter context. A memory-fit estimate is not a speed guarantee.</dd>
        <dt>A network folder is missing</dt>
        <dd>Begin with a local folder. A Windows service needs its own file-server login under Settings → Model storage on each machine; a drive letter mapped in your desktop session may not exist for it.</dd>
      </dl>
      <p data-plain>Not sure what went wrong, or just have a question? <a href={askUrl}>Ask it on GitHub</a>. You need a free GitHub account.</p>
      <p><a href="https://github.com/eugene-plexus/specs/issues/new">Report a problem on GitHub</a>. Include <strong>{release.version}</strong>, your OS, GPU and RAM, what you were trying to do, and the error text. Remove passphrases, API keys, private paths and prompts from shared logs or screenshots.</p>
    </section>
  </div>
</SiteLayout>
<script>
  // Mark the visitor's own system among the choices, so the first thing to
  // click is the right one. Phones and tablets are left unmarked: someone
  // reading on a phone is installing on another computer.
  const agent = navigator.userAgent;
  const hint = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ?? navigator.platform ?? '';
  const platform = hint.toLowerCase();
  let os: string | null = null;
  if (!/android|iphone|ipad|ipod|mobile/i.test(agent)) {
    if (platform.includes('win') || /windows/i.test(agent)) os = 'windows';
    else if (platform.includes('mac') || /macintosh/i.test(agent)) os = 'mac';
    else if (platform.includes('linux') || /linux|x11/i.test(agent)) os = 'linux';
  }
  const choice = os ? document.querySelector<HTMLElement>(`.choice[data-os="${os}"]`) : null;
  if (choice) {
    choice.dataset.detected = 'true';
    choice.querySelector<HTMLElement>('.choice-detected')?.removeAttribute('hidden');
  }
</script>
<style>
  .install-page { max-width: 960px; padding-block: 4rem; }
  .install-intro { max-width: 760px; }
  .install-intro-layout { display: grid; grid-template-columns: minmax(0, 1fr) 176px; gap: 2rem; align-items: start; }
  .install-guide { padding-top: 3rem; }
  @media (max-width: 760px) {
    .install-intro-layout { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .install-guide { grid-row: 1; width: 112px; padding-top: 0; }
  }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.12; letter-spacing: -.015em; margin-block: 1rem 1.5rem; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; margin-bottom: 1.25rem; }
  h3 { font-size: 1.125rem; margin-top: 2rem; }
  p, li, dd { line-height: 1.8; }
  p { margin-block: 1rem; }
  a { color: var(--accent-left); text-underline-offset: .2em; }
  section a, .alpha-notice a { text-decoration: underline; }
  .alpha-notice { padding: 1rem 1.25rem; background: var(--panel-soft); border-left: 3px solid var(--accent-left); }
  .install-nav { margin-block: 2rem; }
  .chooser-label { font-weight: 650; margin-block: 0 .75rem; }
  .chooser { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; }
  .chooser li + li { margin-top: 0; }
  .choice { position: relative; display: flex; flex-direction: column; gap: .35rem; padding: 1rem 1.1rem; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); }
  .choice:hover { border-color: var(--border-hover); }
  .choice:focus-within { outline: 2px solid var(--accent-left); outline-offset: 2px; }
  .choice a { color: var(--foreground); font-size: 1.05rem; font-weight: 650; text-decoration: none; }
  .choice a:focus-visible { outline: none; }
  /* The whole card is the link's target, not only its name. */
  .choice a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .choice-note { color: var(--muted); font-size: .875rem; line-height: 1.5; }
  .choice-detected { align-self: flex-start; padding: .1rem .55rem; color: var(--on-accent-left); background: var(--accent-left); border-radius: 999px; font-size: .75rem; font-weight: 600; }
  .choice[data-detected="true"] { border-color: var(--accent-left); box-shadow: inset 0 0 0 1px var(--accent-left); }
  .section-links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-block: 1.25rem 0; font-size: .9375rem; }
  .expect-help { display: flex; align-items: center; gap: .75rem; color: var(--muted); }
  .with-face { display: flex; align-items: center; gap: .75rem; }
  @media (max-width: 760px) { .chooser { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
