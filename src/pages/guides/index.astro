---
import { ArrowRight, BookSearch, Boxes, CircleArrowUp, Cloud, FileSearch, Globe, Hammer, HardHat, Lock, NotebookPen, ScanSearch, Server, SquareTerminal, Wrench } from '@lucide/astro';
import Mascot from '../../components/Mascot.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import release from '../../data/alpha-release.json';
import { guides } from '../../lib/guides';

const all = guides();
// One picture per guide, so the list is not a wall of text. A guide
// without one fails the build.
const icons: Record<string, typeof ArrowRight> = {
  'update-from-v0-1-0': CircleArrowUp,
  'add-a-provider': Cloud,
  'add-web-search': Globe,
  'run-search-models': ScanSearch,
  'manage-models': Boxes,
  'connect-codex-and-claude-code': SquareTerminal,
  'set-up-rag': BookSearch,
  'install-workbench': Hammer,
  'workbench-memory': NotebookPen,
  'workbench-documents': FileSearch,
  'workbench-tools': Wrench,
  'set-up-a-job-site': HardHat,
  'add-a-warm-standby': Server,
  'container-https': Lock,
};
for (const guide of all) if (!icons[guide.slug]) throw new Error(`Guide ${guide.slug} needs an icon in src/pages/guides/index.astro`);
const groups = [...new Set(all.map((guide) => guide.group))];
---

<SiteLayout title="Guides to running LLMs locally | Eugene Plexus" description={`Step-by-step guides to running LLMs locally with Eugene Plexus ${release.version}: local RAG, Claude Code and Codex with local models, which models fit your GPU, web search, providers, Workbench and Job Sites.`}>
  <div class="container guides-page">
    <header class="guides-intro">
      <div>
        <p class="eyebrow">Guides · {release.version}</p>
        <h1>Step-by-step guides</h1>
        <p data-plain>Short guides for the jobs people do most, in the words on your screen. New to Eugene? <a href="/install">Install it first</a>.</p>
      </div>
      <Mascot pose="guide" size={150} eager />
    </header>
    {groups.map((group) => (
      <section aria-labelledby={`group-${group.toLowerCase().replace(/[^a-z]+/g, '-')}`}>
        <h2 id={`group-${group.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{group}</h2>
        <ul class="guide-list" role="list">
          {all.filter((guide) => guide.group === group).map((guide) => {
            const Icon = icons[guide.slug];
            return (
              <li class="guide-card">
                <Icon class="guide-icon" size={28} stroke-width={1.5} aria-hidden="true" />
                <div>
                  <a href={guide.path}>{guide.title} <ArrowRight size={16} aria-hidden="true" /></a>
                  <p data-plain>{guide.description}</p>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</SiteLayout>

<style>
  .guides-page { max-width: 960px; padding-block: 4rem; }
  .guides-intro { display: grid; grid-template-columns: minmax(0, 1fr) 150px; gap: 2rem; align-items: center; }
  .guides-intro a { color: var(--accent-left); text-decoration: underline; text-underline-offset: .2em; }
  @media (max-width: 640px) { .guides-intro { grid-template-columns: minmax(0, 1fr); } .guides-intro :global(.mascot) { grid-row: 1; width: 104px; } }
  h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.12; letter-spacing: -.015em; margin-block: 1rem 1.25rem; }
  h2 { font-size: 1.375rem; margin-block: 2.5rem 1rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .guide-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  @media (max-width: 640px) { .guide-list { grid-template-columns: minmax(0, 1fr); } }
  .guide-card { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: start; padding: 1rem 1.1rem; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); }
  .guide-card :global(.guide-icon) { color: var(--accent-left); margin-top: .1rem; }
  .guide-card:nth-child(even) :global(.guide-icon) { color: var(--accent-right); }
  .guide-card:hover { border-color: var(--border-hover); }
  .guide-card:focus-within { outline: 2px solid var(--accent-left); outline-offset: 2px; }
  .guide-card a { display: inline-flex; align-items: center; gap: .4rem; color: var(--foreground); font-weight: 650; text-decoration: none; }
  .guide-card a:focus-visible { outline: none; }
  .guide-card a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .guide-card p { margin: .4rem 0 0; color: var(--muted); font-size: 1.0625rem; line-height: 1.55; }
</style>
