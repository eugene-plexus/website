---
import { ArrowLeft } from '@lucide/astro';
import Face from '../../components/Face.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import release from '../../data/alpha-release.json';
import { guides, type Guide } from '../../lib/guides';

export function getStaticPaths() {
    return guides().map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const { Content } = guide;
const report = `https://github.com/eugene-plexus/specs/issues/new?title=${encodeURIComponent(`Guide: ${guide.title}`)}`;
---

<SiteLayout title={`${guide.title} | Eugene Plexus guides`} description={guide.description}>
  <article class="container guide-page">
    <header>
      <p class="eyebrow"><a href="/guides">Guides</a> · {release.version}</p>
      <h1>{guide.title}</h1>
      <p class="guide-lead">{guide.description}</p>
    </header>
    <div class="guide-body"><Content /></div>
    <footer class="guide-footer">
      <p class="with-face"><Face size={36} /><span>Something different on your screen? <a href={report}>Tell us on GitHub</a>, with your version and what you saw.</span></p>
      <a class="text-link" href="/guides"><ArrowLeft size={17} aria-hidden="true" /> All guides</a>
    </footer>
  </article>
</SiteLayout>

<style>
  .guide-page { max-width: 820px; padding-block: 4rem; }
  .guide-page .eyebrow a { color: inherit; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.15; letter-spacing: -.015em; margin-block: 1rem; }
  .guide-lead { color: var(--muted); font-size: 1.0625rem; line-height: 1.7; }
  .guide-body { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: .5rem; }
  .guide-body :global(h2) { font-size: clamp(1.375rem, 3vw, 1.75rem); line-height: 1.3; margin-block: 2.25rem 1rem; scroll-margin-top: 6rem; }
  .guide-body :global(p), .guide-body :global(li) { line-height: 1.8; }
  .guide-body :global(p) { margin-block: 1rem; }
  .guide-body :global(ol), .guide-body :global(ul) { padding-left: 1.5rem; }
  .guide-body :global(li + li) { margin-top: .6rem; }
  .guide-body :global(a) { color: var(--accent-left); text-decoration: underline; text-underline-offset: .2em; }
  .guide-body :global(code) { font-family: var(--font-mono); font-size: .875em; overflow-wrap: anywhere; }
  .guide-body :global(pre) { padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); white-space: pre-wrap; overflow-wrap: anywhere; }
  .guide-body :global(details) { margin-block: 1.25rem; padding: 1rem; background: var(--panel-soft); border-radius: var(--radius); }
  .guide-body :global(summary) { cursor: pointer; font-weight: 600; }
  .guide-body :global(blockquote) { margin: 1.25rem 0; padding: .75rem 1.25rem; background: var(--panel-soft); border-left: 3px solid var(--accent-left); }
  .guide-body :global(img) { max-width: 100%; height: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .guide-footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .with-face { display: flex; align-items: center; gap: .75rem; }
  .guide-footer a { color: var(--accent-left); }
</style>
