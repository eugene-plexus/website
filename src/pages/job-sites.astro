---
import { ArrowRight, ArrowUpRight, Clock, KeyRound, ListChecks, PlugZap, ShieldCheck, UserRound } from '@lucide/astro';
import Shot from '../components/Shot.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import release from '../data/alpha-release.json';
import docs from '../data/docs-revision.json';

const matrix = `https://github.com/eugene-plexus/specs/blob/${docs.commit}/docs/support-matrix.md#workbench-and-job-sites`;
const promises = [
  { icon: PlugZap, title: 'It connects out', text: 'A machine joins with one command and opens every connection itself. It accepts none, and needs no VPN or cloud service.' },
  { icon: UserRound, title: 'Your tools run as you', text: "Each person's tools run as their own account on that machine, in their own workspaces." },
  { icon: KeyRound, title: 'Signed by your keys', text: 'Calls are signed with keys only that person holds. A command the install’s root forges is held, and never runs.' },
  { icon: ShieldCheck, title: 'Risky calls wait', text: 'A risky call is held until it is approved, at the machine or with a passkey.' },
  { icon: Clock, title: 'Access closes itself', text: 'Access windows close on their own, and commands stay off on a machine until an administrator allows them there.' },
  { icon: ListChecks, title: 'You can see what ran', text: 'Workbench keeps an audit list of the calls made on each site.' },
];
---

<SiteLayout title="Job Sites | Eugene Plexus" description="Job Sites let Workbench work on a person's own machines, wherever they are: one command to join, no incoming connections, no VPN, and each person's tools run as their own account.">
  <div class="container product-page">
    <header class="product-intro">
      <p class="eyebrow">Job Sites · {release.version}</p>
      <h1>Let Workbench work on your own computers</h1>
      <p class="lead" data-plain>A Job Site lets Workbench work on a person's own computer: its files, its tools and, if allowed, its commands. Nothing on the router needs opening.</p>
      <p class="actions"><a class="button button-primary" href="/guides/set-up-a-job-site">Set up a Job Site <ArrowRight size={17} aria-hidden="true" /></a></p>
    </header>

    <section aria-labelledby="promises-title">
      <h2 id="promises-title">Safeguards</h2>
      <ul class="promises" role="list" data-plain>
        {promises.map((item) => (
          <li>
            <item.icon size={24} stroke-width={1.5} aria-hidden="true" />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    <Shot name="job-sites" caption="A person's own machine as a Job Site, in Workbench." alt="Workbench's Job sites page for one person: the machine desk-pc is online, their calls run as their own account there, a note says no tool runs until they add their own key at the machine, and sections follow for passkeys, their signature window and their workspaces." />

    <section class="limits" aria-labelledby="limits-title">
      <h2 id="limits-title">Known limits</h2>
      <ul>
        <li>Job Sites cannot yet copy between machines.</li>
        <li>A machine that is only a site, without a full Eugene install, is not supported yet.</li>
        <li>On Windows, a call waits until the person signs in to that machine.</li>
        <li>Entra ID and domain accounts, and network shares, are untested.</li>
      </ul>
    </section>

    <details class="checked">
      <summary>How we checked</summary>
      <p>A Windows site joined a root in WSL2 behind a real reverse proxy, and Linux sites run in CI. Each person's calls ran as their own Windows account; a signed command ran as the person, and one the root forged was held and never ran. A passkey approval used Chrome's virtual authenticator; a real phone or hardware key has not been tried. <a href={matrix}>The support matrix</a> has each record. <ArrowUpRight size={14} aria-hidden="true" /></p>
    </details>
  </div>
</SiteLayout>

<style>
  .product-page { max-width: 1100px; padding-block: 4rem; }
  .product-intro h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.12; letter-spacing: -.015em; margin-block: 1rem 1.25rem; max-width: 820px; }
  .lead { max-width: 720px; font-size: 1.25rem; line-height: 1.7; color: var(--muted); }
  .actions { margin-block: 1.75rem 2.5rem; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); margin-block: 2.5rem 1.25rem; }
  .promises { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 2rem; }
  @media (max-width: 900px) { .promises { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .promises { grid-template-columns: minmax(0, 1fr); } }
  .promises svg { color: var(--accent-left); }
  .promises h3 { font-size: 1.1875rem; margin: .6rem 0 .35rem; }
  .promises p { margin: 0; color: var(--muted); line-height: 1.6; }
  .limits { margin-top: 2rem; padding: .25rem 1.25rem 1rem; border-left: 3px solid var(--accent-right); background: var(--panel); }
  .limits h2 { font-size: 1.25rem; margin-block: 1rem .5rem; }
  .limits ul { margin: 0; padding-left: 1.2rem; }
  .limits li { line-height: 1.7; }
  .checked { margin-top: 2rem; padding: 1rem 1.1rem; background: var(--panel-soft); border-radius: var(--radius); }
  .checked summary { cursor: pointer; font-weight: 600; }
  .checked p { line-height: 1.7; }
  .checked a { color: var(--accent-left); }
</style>
