---
import { AppWindow, ArrowDown, ArrowRight, ArrowUpRight, Cloud, Cpu, Database, FolderOpen, Globe, HardDrive, House, KeyRound, Monitor, Radio, Search, Server, ShieldCheck, Terminal } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import release from '../data/alpha-release.json';
import docs from '../data/docs-revision.json';
import { cacheAwareBalancingShipped } from '../lib/features';

const title = 'Architecture | Eugene Plexus';
const description = 'How the parts of Eugene Plexus fit together: the agent on each machine, the gateway your tools talk to, the drivers and engines behind it, the model library, the control root, and the apps and Job Sites around them. With the current limits.';
const guides = `https://github.com/eugene-plexus/specs/blob/${docs.commit}/docs`;
const records = 'https://github.com/eugene-plexus/specs/blob/main/docs/acceptance';

const components = [
  {
    id: 'agent', name: 'Agent', icon: Server, where: 'One per machine',
    what: 'The process on each machine. It installs, updates and removes llama.cpp, MLX and Strata, drives a vLLM you installed, checks memory before launch, starts search and result-sorting models, installs apps, and serves the web UI. It can keep a local copy of the models it runs.',
    talks: 'Local components and engines, the control root for enrollment and discovery, and other agents for console requests.', repo: 'agent',
  },
  {
    id: 'gateway', name: 'Gateway', icon: Radio, where: 'One per install',
    what: `One address for OpenAI-compatible chat, Responses, embeddings, rerank and media requests, plus Anthropic Messages. Every format shares routing, ${cacheAwareBalancingShipped ? 'cache-aware ' : ''}replica balancing, ordered failover, wake-on-demand and request metrics.`,
    talks: 'Your tools on one side; every driver on the other. Reads model defaults from the Library through its agent.', repo: 'gateway',
  },
  {
    id: 'driver', name: 'Inference driver', icon: Cpu, where: 'One per backend',
    what: 'A small adapter in front of one backend: a llama.cpp, vLLM, MLX or Strata runtime, an Ollama or LM Studio server, a cloud account such as Gemini, OpenAI, OpenRouter or ElevenLabs, or a subscription CLI. It translates requests and reports what the backend can do.',
    talks: 'The gateway above it; one backend below it.', repo: 'inference-driver',
  },
  {
    id: 'tool-driver', name: 'Tool driver', icon: Search, where: 'One per search account',
    what: 'Runs web search for every API on a Brave, Google Search or SearXNG account, in the order you set. Only the search terms reach the search service.',
    talks: 'The gateway, and one search service.', repo: 'tool-driver',
  },
  {
    id: 'library', name: 'Library', icon: Database, where: 'One per install',
    what: 'Your model folders, and where to find more: Hugging Face and compatible hubs, each with its own token, and the engines’ own lists. It says which engines can run each model and how it fits, keeps named profiles, downloads and prepares models, and deletes one with every file listed first.',
    talks: 'The disk, the model hubs, agents launching models, and gateways reading model defaults.', repo: 'library',
  },
  {
    id: 'control', name: 'Control root', icon: ShieldCheck, where: 'One active per install',
    what: 'The trust root, on one machine or across a homelab. It keeps the machine registry and replicated control state, signs people and apps in, issues one-time join tokens, coordinates signed rekeying, and can have a warm standby.',
    talks: 'Every machine’s agent and every Job Site. It spawns nothing itself.', repo: 'control',
  },
  {
    id: 'ui', name: 'Web UI', icon: Monitor, where: 'Served by every agent',
    what: 'Home for setup and a first reply, then the whole install from any machine’s console: Discover, Library, Backends, Routing, Metrics, Machines, Logs, People and Settings. Static files, not a separate server.',
    talks: 'Its own agent, which forwards to the right component wherever it runs.', repo: 'ui',
  },
  {
    id: 'apps', name: 'Apps', icon: AppWindow, where: 'Installed from the console',
    what: 'Workbench, Eugene’s own chat app, and Open WebUI. On a Windows service or a Linux system install, each runs in an operating-system account of its own. Both sign people in with Eugene.',
    talks: 'The gateway for models, and the control root for sign-in.', repo: 'workbench',
  },
  {
    id: 'job-site', name: 'Job Site', icon: House, where: 'On a person’s own machine',
    what: 'Lets Workbench work on that machine, wherever it is. It joins with one command, opens every connection itself, and runs the person’s tools as their own account, with calls signed by keys only they hold.',
    talks: 'The control root, over connections it opens.', repo: 'site-host',
  },
];

const journey = [
  { step: '1', title: 'Your tool asks', text: 'An app, editor or coding agent sends an OpenAI-style request or Anthropic Messages with a client key. The Messages route accepts a bearer token or x-api-key; OpenAI routes use bearer tokens.' },
  { step: '2', title: 'The gateway chooses', text: 'It resolves the model, checks readiness, wakes it if needed, and balances replicas, skipping one whose model is still loading. Omitted generation settings come from that model’s default profile, then gateway settings. Eligible backend failures can move the request to the next configured tier.' },
  { step: '3', title: 'The driver translates', text: 'One driver turns the request into its backend protocol. A setting the backend ignores is named in a response header, not refused. Token streaming depends on that backend; Codex CLI returns whole messages rather than individual tokens.' },
  { step: '4', title: 'The engine generates', text: 'llama.cpp, vLLM, MLX, Strata, Ollama or a cloud provider does the actual work on the hardware it has.' },
  { step: '5', title: 'The request is recorded', text: 'Metrics retain the serving backend, timing, tier, and failed attempts for both chat formats. OpenAI replies include routing metadata in the body or final stream frame; Anthropic keeps its own body format and uses headers.' },
];

const glossary = [
  { term: 'Install', text: 'One control plane: a control root, a gateway, a library, and every machine that has joined them. One passphrase.' },
  { term: 'Node', text: 'A machine in an install. Each node runs one agent.' },
  { term: 'Component', text: 'One of the four services: gateway, inference driver, library, control root. The agent starts them.' },
  { term: 'Runtime', text: 'An inference engine the agent started and supervises, such as one llama.cpp process serving one model.' },
  { term: 'Backend', text: 'Anything a driver can send requests to: a runtime, an external server like Ollama, a cloud API, or a subscription CLI.' },
  { term: 'Replica', text: 'Two or more backends serving the same model. The gateway balances between them.' },
  { term: 'Search model', text: 'A model that turns text into numbers for finding passages by meaning (embedding), or one that sorts what a search found (rerank).' },
  { term: 'Job Site', text: 'A person’s own machine where Workbench can work for them, joined to the install over connections it opens.' },
];
---

<SiteLayout title={title} description={description}>
  <section class="section arch-hero" aria-labelledby="arch-title">
    <div class="container">
      <p class="eyebrow"><span class="section-index">Architecture</span></p>
      <h1 id="arch-title">How it fits together<span class="heading-period">.</span></h1>
      <p class="arch-lead">Eugene Plexus installs and manages engines, helps choose model settings for your hardware, and connects compatible tools to local and cloud backends. One machine or a homelab, the same layers do the work. It is not an inference engine. Its own chat app, Workbench, is an optional app you install from the console.</p>
      <p class="arch-lead">{release.version} snapshot: <time datetime="2026-10-13">October 13, 2026</time>. <a href="/install">Install it</a>. <a href="#status">Current boundaries</a>.</p>
    </div>
  </section>

  <section class="section arch-section arch-layers-section" id="layers" aria-labelledby="layers-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-index">01 /</span> The layers</p>
        <h2 id="layers-title">Five layers, one address.</h2>
        <p>Inference flows through the gateway and a driver. Beside that path, the agent supervises engines, the library prepares models, and the control root maintains the install. Discovery, key checks, model defaults and a model wake can still depend on those services.</p>
      </div>

      <figure class="layers" aria-labelledby="layers-caption">
        <div class="layers-stack">
          <div class="layer layer-tools">
            <div class="layer-label"><Terminal size={18} aria-hidden="true" /><span>Your tools</span></div>
            <ul class="chips">
              <li>Workbench</li><li>Claude Code</li><li>Codex</li><li>Open WebUI</li><li>OpenAI-compatible tools</li><li>The playground</li>
            </ul>
            <p class="layer-note">Chat, tools, embeddings, rerank and media requests, with revocable client keys. <a href="#status">Compatibility has limits.</a></p>
          </div>
          <div class="layer-arrow" aria-hidden="true"><ArrowDown size={18} /><span>OpenAI or Anthropic Messages</span><ArrowDown size={18} /></div>
          <div class="layer layer-gateway">
            <div class="layer-label"><Radio size={18} aria-hidden="true" /><span>Gateway</span></div>
            <ul class="chips">
              <li>Routing</li><li>Replica balancing</li><li>Failover tiers</li><li>Idle unload &amp; wake</li><li>Web search</li><li>Metrics</li>
            </ul>
            <p class="layer-note">One per install. The only thing your tools need to know about.</p>
          </div>
          <div class="layer-arrow" aria-hidden="true"><ArrowDown size={18} /><span>one driver per backend</span><ArrowDown size={18} /></div>
          <div class="layer layer-drivers">
            <div class="layer-label"><Cpu size={18} aria-hidden="true" /><span>Inference drivers</span></div>
            <ul class="chips">
              <li>Driver</li><li>Driver</li><li>Driver</li><li>Driver</li>
            </ul>
            <p class="layer-note">A thin adapter in front of each backend. It translates and reports capabilities.</p>
          </div>
          <div class="layer-arrow" aria-hidden="true"><ArrowDown size={18} /><span>the backend&rsquo;s own API</span><ArrowDown size={18} /></div>
          <div class="layer layer-engines">
            <div class="layer-label"><Cloud size={18} aria-hidden="true" /><span>Engines and backends</span></div>
            <ul class="chips">
              <li class="chip-strong">llama.cpp</li><li class="chip-strong">vLLM</li><li class="chip-strong">MLX</li><li class="chip-strong">Strata (experimental)</li><li>Ollama</li><li>LM Studio</li><li>Cloud APIs</li><li>Claude Code CLI</li><li>Codex CLI</li>
            </ul>
            <p class="layer-note">llama.cpp, MLX and Strata are installed and supervised; vLLM is user-installed and supervised. External servers stay under your control. CLI backends invoke your installed tools using their existing login.</p>
          </div>
          <div class="layer-arrow" aria-hidden="true"><ArrowDown size={18} /><span>runs on</span><ArrowDown size={18} /></div>
          <div class="layer layer-hardware">
            <div class="layer-label"><HardDrive size={18} aria-hidden="true" /><span>Your hardware</span></div>
            <ul class="chips">
              <li>GPUs</li><li>RAM</li><li>Your model directories</li>
            </ul>
            <p class="layer-note">Local engines use your machines. Cloud providers run on their own hardware.</p>
          </div>
        </div>

        <aside class="layers-rail" aria-label="Services beside the request path">
          <div class="rail-card rail-agent">
            <div class="layer-label"><Server size={18} aria-hidden="true" /><span>Agent</span></div>
            <p>One per machine. Starts and watches everything on this box. Serves the web UI.</p>
          </div>
          <div class="rail-card rail-library">
            <div class="layer-label"><Database size={18} aria-hidden="true" /><span>Library</span></div>
            <p>Your models on disk, per-model settings, discovery, downloads, and fit guidance.</p>
          </div>
          <div class="rail-card rail-control">
            <div class="layer-label"><ShieldCheck size={18} aria-hidden="true" /><span>Control root</span></div>
            <p>Which machines belong to this install, and the keys they trust each other with.</p>
          </div>
        </aside>
        <figcaption id="layers-caption">Client inference goes directly to the gateway. The browser console uses the agent as a proxy; the control root does not relay model output.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section arch-section" id="components" aria-labelledby="components-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-index">02 /</span> The components</p>
        <h2 id="components-title">Nine building blocks, distinct jobs.</h2>
        <p>Each has its own repository. The agent supervises the services on its machine, and the UI is a static export it serves. Every service generates its types from pinned OpenAPI 3.1 contracts in the specs repository. Components share schemas, not code.</p>
      </div>
      <div class="component-grid">
        {components.map((c) => (
          <article class="component-card" id={c.id}>
            <div class="component-head">
              <c.icon size={24} stroke-width={1.5} aria-hidden="true" />
              <h3>{c.name}</h3>
              <span class="where">{c.where}</span>
            </div>
            <p>{c.what}</p>
            <p class="talks"><strong>Talks to:</strong> {c.talks}</p>
            <a href={`https://github.com/eugene-plexus/${c.repo}`}>Source <ArrowUpRight size={14} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section arch-section arch-journey-section" id="request" aria-labelledby="request-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-index">03 /</span> One request</p>
        <h2 id="request-title">What happens when a tool asks a question.</h2>
        <p>The whole point of the layering: your tool never has to know which machine, which engine, or which model file. It asks the gateway, and the answer says where it went.</p>
      </div>
      <ol class="journey">
        {journey.map((j, i) => (
          <li class="journey-step">
            <span class="journey-number" aria-hidden="true">{j.step}</span>
            <h3>{j.title}</h3>
            <p>{j.text}</p>
            {i < journey.length - 1 && <ArrowRight class="journey-arrow" size={20} aria-hidden="true" />}
          </li>
        ))}
      </ol>
      <p class="journey-rule"><strong>One rule worth knowing:</strong> failover happens before the first token. Once an answer has started streaming, the gateway will not splice a second model onto it. A cut-off answer is reported as cut off, never quietly completed by someone else.</p>
      <p class="journey-rule"><strong>Not every failure is retryable:</strong> a deadline while a backend is still computing returns a timeout, not a second computation on another replica. An unreachable host can still fail over. Embeddings fail over only between replicas of the same model, never into a different vector space.</p>
    </div>
  </section>

  <section class="section arch-section" id="topologies" aria-labelledby="topologies-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-index">04 /</span> One computer, or several</p>
        <h2 id="topologies-title">The same pieces, placed differently.</h2>
        <p>There is one shape, not two products. On a single PC every component runs beside the engines. Across machines, the control plane moves to wherever is convenient and each GPU box keeps only what needs the hardware.</p>
      </div>
      <div class="topologies">
        <figure class="topology">
          <figcaption><Monitor size={18} aria-hidden="true" /> One computer</figcaption>
          <div class="machine">
            <div class="machine-title">Your PC</div>
            <div class="box box-agent">Agent</div>
            <div class="box-row">
              <div class="box">Control root</div>
              <div class="box">Gateway</div>
              <div class="box">Library</div>
            </div>
            <div class="box-row">
              <div class="box box-driver">Driver</div>
              <div class="box box-driver">Driver</div>
            </div>
            <div class="box-row">
              <div class="box box-engine">llama.cpp</div>
              <div class="box box-engine">Ollama</div>
            </div>
            <div class="box box-disk"><FolderOpen size={15} aria-hidden="true" /> Your model folders</div>
          </div>
          <p class="topology-note">Everything on one box. The browser opens the agent&rsquo;s address and the gateway&rsquo;s port is the one your tools use.</p>
        </figure>

        <figure class="topology topology-multi">
          <figcaption><Globe size={18} aria-hidden="true" /> Several machines</figcaption>
          <div class="multi">
            <div class="machine machine-plane">
              <div class="machine-title">Control-plane host <span>a NAS container, a small server, or one of the PCs</span></div>
              <div class="box box-agent">Agent</div>
              <div class="box-row">
                <div class="box">Control root</div>
                <div class="box">Gateway</div>
                <div class="box">Library</div>
              </div>
              <div class="box box-disk"><FolderOpen size={15} aria-hidden="true" /> Shared model folder</div>
            </div>
            <div class="multi-links" aria-hidden="true">
              <span class="link-line"></span>
              <span class="link-label">joined to one install &middot; one passphrase &middot; models mounted on each GPU box</span>
              <span class="link-line"></span>
            </div>
            <div class="gpu-boxes">
              <div class="machine machine-gpu">
                <div class="machine-title">GPU machine A</div>
                <div class="box box-agent">Agent</div>
                <div class="box-row"><div class="box box-driver">Driver</div><div class="box box-driver">Driver</div></div>
                <div class="box-row"><div class="box box-engine">vLLM</div><div class="box box-engine">llama.cpp</div></div>
              </div>
              <div class="machine machine-gpu">
                <div class="machine-title">GPU machine B</div>
                <div class="box box-agent">Agent</div>
                <div class="box-row"><div class="box box-driver">Driver</div></div>
                <div class="box-row"><div class="box box-engine">Ollama</div></div>
              </div>
            </div>
          </div>
          <p class="topology-note">Each machine runs an agent. A Library folder records its mounts once; nodes can override the path and optionally keep a local copy. Tools use one gateway, and any agent&rsquo;s console can manage the enrolled nodes. A second machine can stand by as the control root. A Job Site is a person&rsquo;s own machine anywhere, joined over connections it opens.</p>
        </figure>
      </div>
    </div>
  </section>

  <section class="section arch-section arch-principles-section" id="principles" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-index">05 /</span> What stays where</p>
        <h2 id="principles-title">Yours, on your disk, in plain sight.</h2>
      </div>
      <div class="principles">
        <article class="principle">
          <FolderOpen size={27} stroke-width={1.5} aria-hidden="true" />
          <h3>Model files</h3>
          <p>In the directories you point the library at, with plain names. Downloads land there too. No content-addressed cache, no hidden store. Remove Eugene Plexus and the files are still there.</p>
          <span class="principle-note">Originals stay yours; local copies are optional.</span>
        </article>
        <article class="principle">
          <KeyRound size={27} stroke-width={1.5} aria-hidden="true" />
          <h3>Secrets and trust</h3>
          <p>Operator sessions administer the install; each person signs in with their own password, and named client keys allow inference and can be revoked. Nodes enroll with one-time join tokens, then sign address announcements and verify signed rekeys. With Ed25519 signing, agents and control roots hold signing authority; gateways, libraries and drivers receive public verification keys.</p>
          <span class="principle-note">Trusted hosts and a LAN or mesh VPN, not public exposure.</span>
        </article>
        <article class="principle">
          <Cpu size={27} stroke-width={1.5} aria-hidden="true" />
          <h3>Engines</h3>
          <p>The agent fetches, verifies and keeps llama.cpp in versioned directories, installs MLX and Strata where they fit, and removes any of them from Backends. vLLM is one you install; the agent finds and drives it. None is forked or replaced.</p>
          <span class="principle-note">Upstream, supervised.</span>
        </article>
      </div>
      <p class="journey-rule"><strong>Optional local copies:</strong> a node copies only model files its own declared runtimes use, into a separate directory with a minimum-free-space setting. It manages those copies, not the source files in your Library folders. The first copy takes time; later starts can avoid reading the model over the network again.</p>
    </div>
  </section>

  <section class="section arch-section" id="status" aria-labelledby="status-title">
    <div class="container glossary-layout">
      <div>
        <p class="eyebrow"><span class="section-index">06 /</span> Current boundaries</p>
        <h2 id="status-title">A second release, with limits to know.</h2>
        <p class="glossary-intro">As of October 13, 2026. {release.version} is early software that works, with the limits below. A v0.1.0 install updates from the console, the control root first; an alpha moves to v0.1.0 first. Versioned installers and a matching container image are available; this is not a production-readiness claim. <a href="/install">Installation guide</a>.</p>
        <p class="glossary-intro">The <a href={`${guides}/support-matrix.md`}>support matrix</a> says what has been measured, simulated or is still pending, and the <a href="https://github.com/eugene-plexus/specs/tree/main/docs/acceptance">acceptance records</a> hold each test's setup and results.</p>
        <p class="glossary-intro">For timings, see the <a href={`${records}/control-plane-measurements.md`}>control-plane measurement record</a>, with hardware, baselines and limits for each observation.</p>
        <a class="text-link" href="https://github.com/eugene-plexus/specs/blob/main/docs/design/audience-roadmap.md">Follow the roadmap <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <dl class="glossary">
        <div class="glossary-row" id="known-issues">
          <dt>Known issues</dt>
          <dd>
            <ul class="issues">
              <li>A Claude Code turn reserves its whole answer allowance (32,000 tokens), so a llama.cpp server with a 64k-token pool runs one Claude Code turn at a time. The others wait; they do not fail.</li>
              <li>With many llama.cpp servers on one machine, a reply can stall while llama.cpp saves and restores its prompt cache: 3 turns in 3,808 in our tests.</li>
              <li>Strata runs text only, on one GPU, one request at a time, and its memory fit is unknown.</li>
              <li>Workbench's sorter: its default Sort time (3 s) suits a GPU, where a question takes about 0.6 s, not a typical CPU, where it takes about 7 s. Its gain was measured on questions written for those documents.</li>
              <li>Job Sites cannot yet copy between machines.</li>
              <li>Brave's rate-limit headers are read as Brave documents them, but have not been seen from a live account.</li>
            </ul>
          </dd>
        </div>
        <div class="glossary-row">
          <dt>Client APIs</dt>
          <dd>OpenAI-compatible chat, Responses, tool calling, streaming, embeddings and rerank (Jina, Cohere and TEI requests); speech, transcription and translation, images, video, moderation and plain completions, each going only to a model that says it can do the job; and Anthropic Messages. A chat model is taken to call tools unless its engine or provider has shown it cannot, and a setting a backend ignores is named in the <code>x-eugene-plexus-ignored-settings</code> header. Web search is run by your install, on a Brave, Google Search or SearXNG account; only the search terms reach the search service. <a href={`${guides}/application-workflows.md`}>Claude Code, Codex and Open WebUI</a> have run with actual local models. This is not full vendor API parity.</dd>
        </div>
        <div class="glossary-row">
          <dt>Messages limits</dt>
          <dd>Text, tool calls, images and PDF or text documents reach backends that confirm them, and <code>top_k</code> and structured output are carried. <code>thinking</code> decides whether reasoning comes back as thinking blocks; <code>context_management</code> and cache hints are accepted but not enforced. A document by URL or file id, citations, MCP servers and server-side tools other than web search are refused, in the words Claude Code looks for to carry on without them. See the <a href={`https://github.com/eugene-plexus/specs/blob/${release.specsCommit}/openapi/gateway.yaml`}>gateway contract</a> for the complete mapping.</dd>
        </div>
        <div class="glossary-row">
          <dt>Engines and hosts</dt>
          <dd>llama.cpp and user-installed vLLM have live records on NVIDIA hardware; Windows and Linux in WSL2 have been exercised. Every GPU the operating system lists is detected and served by llama.cpp's Vulkan build where CUDA does not apply, and one model can span several cards; two discrete cards in one machine have not run that yet. MLX runs on GitHub's macOS runners, which expose Metal, and has not run on a physical Mac. Strata, experimental, prepared and ran a 68 GB model on one RTX 5090 under Windows (<a href={`${records}/ls5-preparation-run.md`}>record</a>). Kev decision models remain experimental. The container can run models too; its NVIDIA path awaits a physical run.</dd>
        </div>
        <div class="glossary-row">
          <dt>Library and Discover</dt>
          <dd>Every model and Discover result says whether it runs here, with each engine's reason and fit, checked against a real agent and Library over header-only files and stand-in hubs (<a href={`${records}/ls1-eligibility-run.md`}>record</a>). Each hub uses its own token. Delete lists every file, keeps files another model uses, and refuses while a machine runs the model.</dd>
        </div>
        <div class="glossary-row">
          <dt>Workbench</dt>
          <dd>Memory, documents in a chat, saved documents searched by words and meaning, granted folders and the sorter each ran with a real Workbench and llama.cpp on the processor, with a small model; a run on the owner's own install is still owed (<a href={`${guides}/support-matrix.md#workbench-memory-and-documents`}>support matrix</a>). Tools ran on GitHub's Windows and Ubuntu runners with real service accounts and a scripted model. Open WebUI's document search runs through Eugene's search and sorting models.</dd>
        </div>
        <div class="glossary-row">
          <dt>Apps and sign-in</dt>
          <dd>Workbench and Open WebUI install from the console on any machine. On a Windows service or a Linux system install, each app runs in an operating-system account of its own, with no access to Eugene's keys. Apps sign people in with Eugene over OpenID Connect: the owner with the passphrase, or each person added under People with their own password.</dd>
        </div>
        <div class="glossary-row">
          <dt>Job Sites</dt>
          <dd>A Windows site joined a root in WSL2 behind a real reverse proxy, and Linux sites run in CI. Each person's calls ran as their own Windows account, a signed command ran as the person, and one the root forged was held and never ran (<a href={`${records}/j14b-signed-calls-run.md`}>record</a>). Not yet: copying between machines, a machine that is only a site, and Windows calls while the person is signed out, which wait for them to sign in.</dd>
        </div>
        <div class="glossary-row">
          <dt>Updates and logs</dt>
          <dd>Machines and Needs Attention show every machine's update status, and any console updates any machine. An update re-checks the channel first and installs nothing if the check fails or the target moved. The update from v0.1.0 to {release.version} passed every check on a Linux system install (<a href={`${records}/v0.2.0-release-run.md`}>release run</a>); a Windows machine updating itself has been observed once, not measured. Every machine's log is readable and followed live, with keys and tokens hidden.</dd>
        </div>
        <div class="glossary-row">
          <dt>Windows startup</dt>
          <dd>The Windows installer runs a real service. Starting and stopping it is exercised in Windows CI; a reboot before sign-in has not been checked on a physical machine yet (<a href={`${guides}/support-matrix.md`}>support matrix</a>).</dd>
        </div>
        <div class="glossary-row">
          <dt>Trust boundary</dt>
          <dd>Every machine signs with its own Ed25519 token key, made on that machine and never sent anywhere. The control root publishes a signed list of the keys it trusts, so a stolen worker key reads only what that worker could, and stops working when the root drops it (<a href="https://github.com/eugene-plexus/specs/blob/main/docs/design/per-node-token-keys.md">design</a>). On Linux, Eugene runs under its own account by default, and the Windows install folder is private to the service and administrators. A new install needs a passphrase of at least 12 characters, and browser requests addressed to an unrecognized public host name are refused. Settings guides HTTPS setup and trusted proxies, and the container can serve the console and Workbench on one HTTPS port.</dd>
        </div>
        <div class="glossary-row">
          <dt>Model settings</dt>
          <dd>The default profile supplies maximum output tokens, temperature and top-p when your app omits them. Explicit app settings win. Changes apply after cache refresh without restarting the model; bounded caching lets requests continue during Library outages. <a href={`${records}/r8-profile-defaults-run.md`}>Both API formats and streaming are checked</a>. Launch settings still apply when a runtime is created.</dd>
        </div>
        <div class="glossary-row">
          <dt>Measured limits and remaining checks</dt>
          <dd>Phone layouts and accessibility checks passed; moderated friend sessions and physical platform checks remain open. A finite CPU run with three Open WebUI chat workers and two Claude Code tasks passed its declared targets. This is not a five-user capacity guarantee. See the <a href={`${guides}/support-matrix.md`}>support matrix</a> for measured, simulated and pending configurations.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section arch-section arch-glossary-section" id="glossary" aria-labelledby="glossary-title">
    <div class="container glossary-layout">
      <div>
        <p class="eyebrow"><span class="section-index">07 /</span> The words</p>
        <h2 id="glossary-title">A short glossary.</h2>
        <p class="glossary-intro">Six words that mean specific things here.</p>
        <a class="text-link" href="https://github.com/eugene-plexus/specs/tree/main/docs/design">Read the design documents <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
      <dl class="glossary">
        {glossary.map((g) => (
          <div class="glossary-row">
            <dt>{g.term}</dt>
            <dd>{g.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</SiteLayout>

