---
import { Image } from 'astro:assets';
import { ArrowRight, ArrowUpRight, CodeXml, Dog, HandHeart, Laptop, Users } from '@lucide/astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import workingIntelligence from '../assets/principles-working-intelligence.png';

const principles = [
  {
    icon: Dog,
    title: 'Working with intelligence is part of being human.',
    text: 'For millennia, people have worked alongside the intelligence of other living beings. Dogs and horses have contributed their own perception, learning, and judgment to work alongside people. Our ability to work with intelligence beyond our own has long expanded what we can do.',
  },
  {
    icon: Laptop,
    title: 'AI carries that possibility forward.',
    text: 'Artificial intelligence, including large language models, gives us new ways to put intelligence to work. It can help people learn, create, solve problems, and turn ideas into action. Our purpose is to help everyone benefit from those possibilities.',
  },
  {
    icon: Users,
    title: 'Equal access to intelligence should be a right.',
    text: 'We believe everyone should have the right to benefit from AI. Wealth, geography, and technical expertise should not decide who gets that opportunity. Equal access is the standard we work toward, and every barrier we remove matters.',
  },
  {
    icon: CodeXml,
    title: 'Openness protects that right.',
    text: "Closed, proprietary systems concentrate control over who can use AI and on what terms. Access that depends entirely on a provider's permission can be restricted or withdrawn. Open models and open-source software offer a foundation for lasting access: the freedom to run, study, adapt, and share.",
  },
  {
    icon: HandHeart,
    title: 'Access must be practical.',
    text: 'Available code alone is not enough. People need tools they can understand and use. Eugene Plexus exists to reduce the cost, complexity, and dependence that stand between people and useful AI, making it easier to run intelligence on hardware they control.',
  },
];
---

<SiteLayout
  title="Our principles | Eugene Plexus"
  description="Everyone should have the right to put intelligence to work. Eugene Plexus builds open-source tools to make equal access to AI a practical reality."
>
  <article class="container mission-page">
    <header class="mission-header">
      <p class="eyebrow">Our mission</p>
      <h1>Intelligence within everyone's reach.</h1>
      <p class="mission-statement">Eugene Plexus exists to make equal access to AI a practical reality. We build open-source tools that help people run, control, and put AI to work on their own terms.</p>
    </header>

    <figure class="mission-illustration">
      <Image
        src={workingIntelligence}
        alt="A shepherd with a working dog and horse, a person using their own computer, and three neighbors sharing a laptop, connected by a winding blue line."
        widths={[480, 768, 1160, 1740, 2172]}
        sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1050px) calc(100vw - 64px), (max-width: 1240px) calc(100vw - 80px), 1160px"
        format="webp"
        quality={85}
        loading="eager"
      />
      <figcaption>A long history of working together. A future more people can share.</figcaption>
    </figure>

    <section class="guiding-principles" aria-labelledby="principles-title">
      <div class="principles-intro">
        <p class="eyebrow">What we believe</p>
        <h2 id="principles-title">Five principles.<br />One purpose.</h2>
      </div>
      <ol class="mission-principles" role="list">
        {principles.map((principle, index) => (
          <li>
            <span class="principle-marker" aria-hidden="true">
              <principle.icon size={26} stroke-width={1.5} />
              <span class="principle-number">{String(index + 1).padStart(2, '0')}</span>
            </span>
            <div>
              <h3>{principle.title}</h3>
              <p>{principle.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="mission-invitation" aria-labelledby="invitation-title">
      <h2 id="invitation-title">Help make access real.</h2>
      <p>Write code. Improve a guide. Share what worked and what got in your way. Every contribution can put useful AI within someone else's reach.</p>
      <div class="mission-actions">
        <a class="button button-primary" href="https://github.com/eugene-plexus">Build with us <ArrowUpRight size={17} aria-hidden="true" /></a>
        <a class="text-link" href="/install">Try Eugene Plexus <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </section>
  </article>
</SiteLayout>

<style>
  .mission-page { padding-block: 80px; }
  .mission-header { max-width: 850px; padding-bottom: 40px; }
  .eyebrow { color: var(--accent-left); }
  h1 { font-size: clamp(2.5rem, 5.5vw, 4.5rem); margin-block: 22px 28px; }
  .mission-statement { font-size: clamp(1.125rem, 2vw, 1.375rem); max-width: 720px; color: var(--muted); }
  .mission-illustration { margin: 0 0 56px; }
  .mission-illustration img { width: 100%; height: auto; border-radius: var(--radius); }
  .mission-illustration figcaption { margin-top: 18px; color: var(--muted); font-size: 14px; text-align: center; }
  .guiding-principles { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 64px; border-top: 1px solid var(--border); padding-block: 56px 72px; }
  h2 { font-size: clamp(1.75rem, 3vw, 2.25rem); }
  .principles-intro h2 { margin-top: 18px; }
  .mission-principles { list-style: none; margin: 0; padding: 0; }
  .mission-principles li { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 20px; padding-block: 30px; border-bottom: 1px solid var(--border); }
  .mission-principles li:first-child { padding-top: 0; }
  .principle-marker { display: flex; flex-direction: column; align-items: center; gap: 10px; color: var(--accent-left); }
  .principle-number { font: 500 13px / 1.8 var(--font-mono); color: var(--muted); }
  h3 { font-size: 22px; line-height: 1.3; }
  .mission-principles p { margin-top: 14px; color: var(--muted); }
  .mission-invitation { padding: 40px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); }
  .mission-invitation p { max-width: 620px; margin-top: 18px; color: var(--muted); }
  .mission-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 28px; }
  @media (max-width: 760px) {
    .mission-page { padding-block: 48px; }
    .mission-header { padding-bottom: 40px; }
    .mission-illustration { margin-bottom: 36px; }
    .mission-illustration figcaption { font-size: 12px; max-width: 32ch; margin-inline: auto; }
    .guiding-principles { grid-template-columns: 1fr; gap: 32px; padding-block: 36px 40px; }
    .mission-principles li { grid-template-columns: 36px minmax(0, 1fr); gap: 12px; }
    .mission-invitation { padding: 24px; }
  }
</style>
