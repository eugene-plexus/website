---
/**
 * Eugene's face, without the network ring.
 *
 * The reassuring mark, in the spirit of the "Don't Panic" on the Guide's
 * cover: it goes where a reader may be stuck or worried (help, a wrong
 * turn, a question) and not between features as decoration. The full logo
 * stays the brand in the header; the head reads at sizes where the ring
 * turns to noise, which is also why it is the favicon.
 *
 * Decorative beside the words it accompanies, so it has an empty alt.
 */
interface Props {
    size?: number;
    class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
---
<img class:list={['face', className]} src="/eugene-face.svg" alt="" width={size} height={size} decoding="async" />

<style>
    .face {
        flex-shrink: 0;
        vertical-align: middle;
    }
</style>
