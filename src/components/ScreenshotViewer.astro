---
import { X } from '@lucide/astro';
---

<dialog id="screenshot-viewer" class="screenshot-viewer" aria-label="Screenshot viewer">
  <div class="screenshot-frame">
    <div class="screenshot-toolbar">
      <button type="button" class="screenshot-size">Actual size</button>
      <button type="button" class="screenshot-close" aria-label="Close screenshot" autofocus>
        <X size={24} aria-hidden="true" />
      </button>
    </div>
    <div class="screenshot-image" role="region" aria-label="Screenshot image" tabindex="0">
      <img alt="" />
    </div>
  </div>
</dialog>

<script>
  const viewer = document.querySelector<HTMLDialogElement>('#screenshot-viewer')!;
  const image = viewer.querySelector<HTMLImageElement>('img')!;
  const viewport = viewer.querySelector<HTMLDivElement>('.screenshot-image')!;
  const sizeButton = viewer.querySelector<HTMLButtonElement>('.screenshot-size')!;
  const closeButton = viewer.querySelector<HTMLButtonElement>('.screenshot-close')!;
  let opener: HTMLAnchorElement | null = null;
  let startedOnBackdrop = false;

  function setActualSize(actualSize: boolean) {
    viewer.classList.toggle('actual-size', actualSize);
    sizeButton.textContent = actualSize ? 'Fit to screen' : 'Actual size';
    viewport.scrollTo(0, 0);
  }

  // Keep the original URLs for no-JavaScript use and opening in another tab.
  if (typeof viewer.showModal === 'function') {
    document.querySelectorAll<HTMLAnchorElement>('a.shot-open, a.shot-full').forEach((link) => {
      link.setAttribute('aria-haspopup', 'dialog');
      link.setAttribute('aria-controls', viewer.id);
      link.addEventListener('click', (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        opener = link;
        image.alt = link.closest('figure')?.querySelector('img')?.alt ?? 'Screenshot';
        image.src = link.href;
        setActualSize(link.classList.contains('shot-full'));
        viewer.showModal();
        event.preventDefault();
      });
    });
  }

  sizeButton.addEventListener('click', () => setActualSize(!viewer.classList.contains('actual-size')));
  closeButton.addEventListener('click', () => viewer.close());
  viewer.addEventListener('pointerdown', (event) => {
    startedOnBackdrop = event.target === viewer;
  });
  viewer.addEventListener('click', (event) => {
    // Dragging from the image onto the backdrop should not dismiss it.
    if (event.target === viewer && startedOnBackdrop) viewer.close();
  });
  // Native dialog handles Escape, focus containment, and the inert background.
  viewer.addEventListener('close', () => {
    opener?.focus({ preventScroll: true });
    image.removeAttribute('src');
    image.alt = '';
    startedOnBackdrop = false;
  });
</script>

<style>
  :global(html:has(.screenshot-viewer[open])) { overflow: hidden; }

  .screenshot-viewer {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: transparent;
    color: var(--foreground);
    overflow: hidden;
  }
  .screenshot-viewer[open] { display: grid; place-items: center; }
  .screenshot-viewer::backdrop {
    background: rgb(0 0 0 / 60%);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .screenshot-frame {
    display: flex;
    flex-direction: column;
    min-width: min(100%, 14rem);
    max-width: 100%;
    max-height: 100%;
    overflow: hidden;
    border: 1px solid var(--border-hover);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .screenshot-toolbar { display: flex; justify-content: space-between; gap: 1rem; padding: .25rem; }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: .5rem .75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--foreground);
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }
  button:hover { background: var(--panel-hover); }
  button:focus-visible, .screenshot-image:focus-visible { outline-offset: -3px; }
  .screenshot-image { min-height: 0; overflow: auto; overscroll-behavior: contain; }
  img { width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - 6rem); margin-inline: auto; }
  .actual-size .screenshot-frame { width: 100%; }
  .actual-size img { max-width: none; max-height: none; }
</style>
